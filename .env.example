# Nukopijuokite šį failą į ".env" ir įrašykite savo Supabase projekto reikšmes.
# Rasite jas: Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# TIK priedų (parts) modulio vartotojų kūrimui (scripts/bootstrap-admin.mjs
# ir Vercel serverless funkcijai api/create-user.js). Rasite:
# Supabase Dashboard -> Project Settings -> API -> "service_role" slaptas raktas.
# NIEKADA nedėkite "VITE_" priešdėlio šiam kintamajam — priešingu atveju jis
# būtų įtrauktas į naršyklės bundle'ą ir bet kas galėtų juo apeiti visas RLS
# taisykles. Produkcijoje šis kintamasis nustatomas Vercel projekto
# aplinkos kintamuosiuose, ne .env faile.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY
